# Session encryption secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain configuration (production)
# NEXT_PUBLIC_MARKETING_DOMAIN=shelvian.co
# NEXT_PUBLIC_APP_DOMAIN=app.shelvian.co

# ─── Supabase ───────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (NEVER expose to browser — server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Signup notification email ──────────────────────────────────────────────
# Admin email to receive notifications when a new user signs up
SIGNUP_NOTIFICATION_EMAIL=ushakov.iggor@gmail.com

# ─── Resend (for signup notifications) ──────────────────────────────────────
# Get API key at https://resend.com — required for signup notifications
RESEND_API_KEY=
# Optional: verified sender (default: onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=Shelvian <notifications@yourdomain.com>

# ─── Google OAuth (configured via Supabase) ─────────────────────────────────
# Set these in: Supabase Dashboard → Authentication → Providers → Google
# Then add to Google Cloud Console → OAuth 2.0 Client IDs:
#   Authorized redirect URI: https://your-project-ref.supabase.co/auth/v1/callback
#
# Also add to Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:         https://app.shelvian.co
#   Redirect URLs:    https://app.shelvian.co/auth/callback
#                     http://localhost:3000/auth/callback  (for local dev)
